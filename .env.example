# Environment Configuration Template for InsightFlow AI

# Application
PROJECT_NAME="InsightFlow AI"
ENVIRONMENT="development"
LOG_LEVEL="INFO"
DEBUG=true

# Server
HOST="0.0.0.0"
PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Database Configuration (PostgreSQL)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="insightflow_user"
POSTGRES_PASSWORD="insightflow_password"
POSTGRES_DB="insightflow_db"

# Database Connection URL (SQLAlchemy 2.0 with psycopg3 driver)
DATABASE_URL="postgresql+psycopg://insightflow_user:insightflow_password@localhost:5432/insightflow_db"
